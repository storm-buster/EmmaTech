# API Configuration
VITE_API_URL=

# Environment
NODE_ENV=production

# RAPHA status proxy (server-side only — used by the Vercel function
# api/rapha/status.ts). MUST be unprefixed (NOT VITE_*) so it is never
# bundled into the browser. RAPHA's /api/v1/health is unauthenticated, so
# NO API key or secret is required here. Must be an https:// URL.
# Example (do NOT commit the real production URL):
#   RAPHA_API_BASE_URL=https://rapha.example.com
RAPHA_API_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────
# Phase 1 — identity + organization foundation (SERVER-SIDE ONLY).
# All of the following are unprefixed (NOT VITE_*) so they are never bundled
# into the browser. Do NOT commit real secret values. In production these
# must come from the platform's secret manager (e.g. Vercel Environment
# Variables), never from source control.
# ─────────────────────────────────────────────────────────────────────────

# HMAC secret used to sign session cookies. REQUIRED for auth. Generate a
# strong random value, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# RAPHA control-plane base URL for trusted server-to-server calls
# (POST /api/v1/service/tenants). Must be https:// in production.
RAPHA_BASE_URL=

# Trusted RAPHA service token, sent as the X-Service-Token header.
# SECRET — never expose to the browser, logs, or API responses.
RAPHA_SERVICE_TOKEN=

# PostgreSQL connection string. When set, the durable Postgres store is used
# and the migrations under /migrations must be applied. When absent, an
# in-memory store is used for LOCAL DEV / TESTS ONLY.
# PRODUCTION FAIL-CLOSED: when NODE_ENV=production and DATABASE_URL is absent,
# the app refuses to start request handling (getStore throws → 503) rather than
# silently using volatile in-memory storage. DATABASE_URL is REQUIRED in prod.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────
# CONFIG CLASSIFICATION
#   PUBLIC CLIENT CONFIG (safe to bundle, may be VITE_*):
#     VITE_API_URL
#   SERVER-ONLY CONFIG (secrets/infra — MUST stay unprefixed, never VITE_*,
#   never in frontend source, public files, or committed .env):
#     SESSION_SECRET, RAPHA_BASE_URL, RAPHA_SERVICE_TOKEN, RAPHA_API_BASE_URL,
#     DATABASE_URL
# PRODUCTION REQUIRES: SESSION_SECRET (auth fails closed → 503 without it) and
# DATABASE_URL (persistence fails closed → 503 without it).
# ─────────────────────────────────────────────────────────────────────────
