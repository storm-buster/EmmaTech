{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/private-deployment",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(login|signup|account|deploy|console|request-access|reports)",
      "destination": "/index.html"
    },
    {
      "source": "/(login|signup|account|deploy|console|request-access|reports)/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(login|signup|account|deploy|console|request-access|reports)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(login|signup|account|deploy|console|request-access|reports)/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
